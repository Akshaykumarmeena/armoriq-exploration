# Copy to .env (git-ignored) and fill in real values. Never commit .env.

# SDK: API key from https://platform.armoriq.ai
ARMORIQ_API_KEY=your-key-here

# Registered agent: use the agent NAME from the console, not its UUID
ARMORIQ_AGENT_ID=your-agent-name-here

# Intent Gateway (step 4): full base URL from console -> Gateway -> Create gateway key.
# Contains a secret key. Form: https://gw.armoriq.ai/v1/t/<gateway-key>/a/<agent-id>
ARMORIQ_GATEWAY_URL=your-gateway-url-here

# Your own model provider key, used through the gateway (set one)
ANTHROPIC_API_KEY=your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=your-openai-key-here

# Fake end-user identity used in SDK demos
DEMO_USER_EMAIL=alice@example.com
