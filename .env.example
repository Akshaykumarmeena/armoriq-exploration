# Copy to .env (git-ignored) and fill in real values. Never commit .env.

# SDK: API key from https://platform.armoriq.ai
ARMORIQ_API_KEY=your-key-here

# Intent Gateway (step 4): gateway key and registered agent id from the console
ARMORIQ_GATEWAY_KEY=your-gateway-key-here
ARMORIQ_AGENT_ID=your-agent-id-here

# Your own model provider key, used through the gateway (step 4)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Fake end-user identity used in SDK demos
DEMO_USER_EMAIL=alice@example.com
